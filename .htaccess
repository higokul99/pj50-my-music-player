<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Route API requests to Laravel Backend
    # Ensure QSA is used to pass query parameters
    RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]

    # 2. Serve Static Files from React Build
    RewriteCond %{DOCUMENT_ROOT}/web/dist/$1 -f
    RewriteRule ^(.*)$ web/dist/$1 [L]

    # 3. React SPA Routing
    # If the request is not for a real file, and not for the API, send to React
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api
    RewriteRule ^(.*)$ web/dist/index.html [L]

    # 4. Special case: explicitly handle the root directory
    RewriteRule ^$ web/dist/index.html [L]
</IfModule>
